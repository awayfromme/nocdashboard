{
  "name": "dashboard",
  "version": "1.0.0",
  "description": "noc dashboard",
  "main": "server.js",
  "scripts": {
    "install-client": "cd client && npm install",
    "start": "concurrently --kill-others-on-fail \"npm run server\" \"npm run start --prefix client\"",
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
    "develop": "concurrently --kill-others-on-fail \"npm run server\" \"npm run start --prefix client\"",
    "heroku-postbuild": "npm run install-client && npm run build",
    "full-install": "npm install && npm install --prefix client"
  },
  "author": "awayfromme",
  "license": "MIT",
  "dependencies": {
    "@devexpress/dx-react-core": "^2.7.4",
    "@syncfusion/ej2-filemanager-node-filesystem": "^18.1.54",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.18.3",
    "concurrently": "^4.0.1",
    "cors": "^2.8.5",
    "d3-time-format": "^3.0.0",
    "express": "^4.17.1",
    "is-empty": "^1.2.0",
    "jqwidgets-scripts": "^11.1.3",
    "jsonwebtoken": "^8.3.0",
    "mongoose": "^5.11.16",
    "morgan": "^1.10.0",
    "node-sass": "^5.0.0",
    "passport": "^0.4.0",
    "passport-jwt": "^4.0.0",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "validator": "^10.9.0"
  },
  "devDependencies": {}
}
